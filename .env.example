# Server Port
PORT=3100

# MongoDB Connection String (Required)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nismara_db?retryWrites=true&w=majority

# Optional Redis Cache
REDIS_URL=redis://localhost:6379

# Discord OAuth / Integration
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3100/auth/discord/callback

# Nismara Guild ID
NISMARA_GUILD_ID=863959415702028318

# Anti-Farming Distance Cap Multiplier (default: 1.25 for +25% max distance)
DISTANCE_CAP_MULTIPLIER=1.25

# Minimum Tracker Client Version Gatekeeper (e.g., 1.0.0)
MIN_TRACKER_VERSION=1.0.0

