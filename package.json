{
  "name": "nismara-tracker-server",
  "version": "1.0.0",
  "description": "Dedicated Backend Server for NismaraTracker In-Game C++ Plugin (Zero Vercel Overhead)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:logs": "pm2 logs nismara-tracker-server",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "mongoose": "^9.9.4",
    "ws": "^8.22.1"
  }
}
